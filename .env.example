# Copy this file to .env and adjust the values.
# Copie este arquivo para .env e ajuste os valores.

# PostgreSQL (docker-compose)
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cryptowallet
POSTGRES_PORT=5432

# API
DATABASE_URL=postgres://admin:change-me@localhost:5432/cryptowallet?sslmode=disable
PORT=8080

# Current prices (CoinGecko) / Cotação atual (CoinGecko)
# Must match the currency used in the registered prices.
# Deve ser a mesma moeda usada nos preços cadastrados.
PRICE_CURRENCY=usd
COINGECKO_API_URL=https://api.coingecko.com/api/v3
# Optional demo key / Chave demo opcional: https://www.coingecko.com/en/api
COINGECKO_API_KEY=
